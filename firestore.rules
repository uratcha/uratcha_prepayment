rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🥩 으랏차 선입금 및 예약 관리 시스템 Firestore 보안 규칙
    // Firebase Authentication 인증을 거친 매장 직원/관리자만 읽기 및 쓰기 허용

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. 선입금 관리 (uratcha_prepayment) 컬렉션
    match /gogi_prepayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }
    match /gogi_prepayment_trash/{trashId} {
      allow read, write: if isAuthenticated();
    }

    // 2. 예약 관리 (uratcha_reservation) 컬렉션
    match /gogi_reservations/{reservationId} {
      allow read, write: if isAuthenticated();
    }
    match /gogi_trash/{trashId} {
      allow read, write: if isAuthenticated();
    }
  }
}
